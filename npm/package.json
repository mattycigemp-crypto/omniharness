{
  "name": "omniharness-cli",
  "version": "0.1.4",
  "description": "OmniHarness — local-first agent orchestration harness for OmniRoute.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattycigemp-crypto/omniharness.git"
  },
  "bin": {
    "omniharness": "cli.js"
  },
  "files": [
    "cli.js",
    "vendor/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts"
  },
  "keywords": ["omniroute", "omniharness", "agents", "orchestration", "cli"],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/provider": "^1.0.0",
    "@mastra/core": "^0.10.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
